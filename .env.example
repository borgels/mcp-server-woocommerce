# The shop's address (https, public host name). The API is at <address>/wp-json/wc/v3.
WOOCOMMERCE_SHOP_URL=
# A REST API key made in the shop: WooCommerce -> Settings -> Advanced -> REST API -> Add key.
# Read permission is enough for the read tools; the write tools need Read/Write.
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
# Allow a shop on a loopback or private address (local development only).
# WOOCOMMERCE_ALLOW_PRIVATE_HOST=false
WOOCOMMERCE_TIMEOUT_MS=30000
WOOCOMMERCE_MAX_CONCURRENCY=4
# Largest response body read from the shop (bytes, max 104857600).
WOOCOMMERCE_MAX_RESPONSE_BYTES=10485760

# Write tools are disabled unless this is true.
WOOCOMMERCE_ENABLE_WRITES=false
# Comma-separated tool names to disable (with or without the woocommerce_ prefix).
WOOCOMMERCE_DISABLED_TOOLS=
# JSONL audit trail; write tools refuse to run if it cannot be written.
WOOCOMMERCE_AUDIT_LOG=

# HTTP transport. A bearer token (>= 32 printable ASCII characters, e.g.
# `openssl rand -hex 32`) is required unless the server binds to loopback.
MCP_HTTP_TOKEN=
# Bind address (HOST is also read; MCP_HTTP_HOST wins):
# MCP_HTTP_HOST=127.0.0.1
# PORT=3000
# MCP_ALLOWED_ORIGINS=
# MCP_ALLOWED_HOSTS=
# MCP_MAX_BODY_BYTES=10485760
# MCP_AUTH_FAILURE_LIMIT=20
# MCP_AUTH_FAILURE_WINDOW_MS=60000
# Allow any browser origin (requires a token):
# MCP_ALLOW_ANY_ORIGIN=false
# Non-loopback bind without a token; isolated networks only:
# MCP_HTTP_ALLOW_UNAUTHENTICATED=false
