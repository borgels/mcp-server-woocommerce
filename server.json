{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.borgels/mcp-server-woocommerce",
  "title": "WooCommerce",
  "description": "Unofficial MCP server for WooCommerce shops: orders, products, customers, sales.",
  "repository": {
    "url": "https://github.com/borgels/mcp-server-woocommerce",
    "source": "github"
  },
  "version": "0.3.1",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "mcp-server-woocommerce",
      "version": "0.3.1",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "WOOCOMMERCE_SHOP_URL",
          "description": "The shop's address (https), e.g. https://shop.example.com.",
          "isRequired": true
        },
        {
          "name": "WOOCOMMERCE_CONSUMER_KEY",
          "description": "REST API consumer key (WooCommerce -> Settings -> Advanced -> REST API).",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "WOOCOMMERCE_CONSUMER_SECRET",
          "description": "REST API consumer secret.",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "WOOCOMMERCE_ENABLE_WRITES",
          "description": "Enable the write tools.",
          "format": "boolean",
          "default": "false"
        },
        {
          "name": "WOOCOMMERCE_DISABLED_TOOLS",
          "description": "Comma-separated tool names to disable."
        },
        {
          "name": "WOOCOMMERCE_AUDIT_LOG",
          "description": "Path of the JSONL audit log. Write tools refuse to run if it cannot be written.",
          "format": "filepath"
        }
      ]
    }
  ]
}
