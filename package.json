{
  "name": "mcp-server-woocommerce",
  "version": "0.3.1",
  "mcpName": "io.github.borgels/mcp-server-woocommerce",
  "description": "Unofficial MCP server for WooCommerce shops: orders, products, customers and sales reports, with opt-in order status, private notes, refunds recorded without moving money, draft products and customer updates.",
  "type": "module",
  "main": "./dist/transports/stdio.js",
  "exports": {
    ".": "./dist/transports/stdio.js",
    "./gateway": {
      "types": "./dist/gateway.d.ts",
      "default": "./dist/gateway.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    ".env.example"
  ],
  "bin": {
    "mcp-server-woocommerce": "./dist/transports/stdio.js"
  },
  "scripts": {
    "build": "tsup src/transports/stdio.ts src/transports/http.ts src/gateway.ts --format esm --dts --clean --sourcemap",
    "dev": "tsx src/transports/stdio.ts",
    "dev:http": "tsx src/transports/http.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build",
    "prepack": "npm run typecheck && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borgels/mcp-server-woocommerce.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "woocommerce",
    "wordpress",
    "e-commerce",
    "webshop",
    "orders",
    "denmark"
  ],
  "author": "",
  "license": "FSL-1.1-ALv2",
  "engines": {
    "node": ">=22.19.0"
  },
  "bugs": {
    "url": "https://github.com/borgels/mcp-server-woocommerce/issues"
  },
  "homepage": "https://github.com/borgels/mcp-server-woocommerce#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ipaddr.js": "2.5.0",
    "undici": "8.12.3",
    "zod": "^4.6.7"
  },
  "overrides": {
    "ip-address": "^10.1.1",
    "hono": "^4.13.19",
    "@hono/node-server": "^2.1.8",
    "fast-uri": "^3.1.9",
    "qs": "^6.17.1",
    "body-parser": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
